ckDate.getHours()}:${String(fallbackDate.getMinutes()).padStart(2, '0')}:${String(fallbackDate.getSeconds()).padStart(2, '0')}`;\n\n  return [{\n    json: {\n      latest_timestamp: formattedFallbackDate,\n      row_number: null,\n      status: null,\n      type: \"fallback_15_days_prior\",\n      note: `No match for ${batchVar}. Subtracted 15 days from newest sheet date (${rowsWithDates[0].Timestamp}).`\n    }\n  }];\n}"
