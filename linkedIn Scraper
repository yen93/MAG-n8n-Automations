r}\n\"comments\": ${commentsStr}\n\"header\": ${headerStr}\n\"entityId\": \"${post.entityId}\"\n\"shareUrn\": \"${post.shareUrn}\"\n\"shareLinkedinUrl\": \"${post.shareLinkedinUrl}\"\n\"engagement\": ${engagementStr}\n\"reactions\": ${reactionsStr}\n\"reactionIds\": ${reactionIdsStr}\n\"commentIds\": ${commentIdsStr}\n\"query\": ${queryStr}`;\n\n    return postString;\n});\n\n// 3. Join all items back into a single massive string separated by newlines\nconst finalSingleString = rawFormattedPosts.join('\\n\\n,\\n\\n');\n\n// 4. Return it as an object property n8n can map downstream\nreturn [\n    {\n        json: {\n            formattedText: finalSingleString\n        }\n    }\n];"
