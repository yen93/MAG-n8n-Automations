        "jsCode": "// Get all items from the \"Get row(s) in sheet\" node\nconst items = $input.all();\n\nconst seenCompanies = new Set();\nconst duplicateRows = [];\n\nfor (const item of items) {\n  const rowData = item.json;\n  \n  // Get the company name (trimming spaces to handle \"Apple \" vs \"Apple\")\n  const companyName = rowData.Company ? rowData.Company.toString().trim() : '';\n  \n  // Skip blank rows so they aren't flagged as duplicates of each other\n  if (!companyName) continue;\n\n  // n8n Google Sheets node usually outputs a \"row_number\" property automatically.\n  // If it's missing, we fall back to the array index + 2 (accounting for 0-index and header row).\n  const rowNumber = rowData.row_number || (items.indexOf(item) + 2);\n\n  if (seenCompanies.has(companyName)) {\n    // If we've seen this company before, this row is a duplicate\n    duplicateRows.push({\n      json: {\n        row_number: rowNumber,\n        company: companyName\n      }\n    });\n  } else {\n    // First time seeing this company, add it to our tracker\n    seenCompanies.add(companyName);\n  }\n}\n\n// Map through the duplicates to inject the total count into every returned item\nconst totalCount = duplicateRows.length;\nreturn duplicateRows.map(item => {\n  item.json.total_duplicates = totalCount;\n  return item;\n});"
