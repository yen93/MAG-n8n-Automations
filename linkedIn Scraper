pth = 0;\n                let endIdx = 0;\n                const openChar = residue[0];\n                const closeChar = openChar === '{' ? '}' : ']';\n\n                for (let i = 0; i < residue.length; i++) {\n                    if (residue[i] === openChar) depth++;\n                    else if (residue[i] === closeChar) depth--;\n                    \n                    if (depth === 0) {\n                        endIdx = i + 1;\n                        break;\n                    }\n                }\n                const jsonSegment = residue.substring(0, endIdx);\n                try {\n                    return JSON.parse(jsonSegment);\n                } catch (e) {\n                    return [];\n                }\n            }\n            return null;\n        };\n\n        // 4. Map back every original property explicitly\n        reconstructedObject.type = extractValue('type');\n        reconstructedObject.id = extractValue('id');\n        reconstructedObject.linkedinUrl = extractValue('linkedinUrl');\n        \n        // Extract raw content body preserving its exact structural returns\n        const contentMatch = block.match(/\"content\":\\s*\"([\\s\\S]*?)\"\\s*\\n\\s*\"contentAttributes\":/);\n        reconstructedObject.content = contentMatch ? contentMatch[1] : extractValue('content');\n\n        reconstructedObject.contentAttributes = extractValue('contentAttributes') || [];\n        reconstructedObject.author = extractValue('author');\n        reconstructedObject.postedAt = extractValue('postedAt');\n        reconstructedObject.postImages = extractValue('postImages') || [];\n\n        // Conditionals for dynamic elements like video and articles\n        if (block.includes('\"postVideo\":')) reconstructedObject.postVideo = extractValue('postVideo');\n        if (block.includes('\"article\":')) reconstructedObject.article = extractValue('article');\n\n        reconstructedObject.socialContent = extractValue('socialContent');\n        reconstructedObject.comments = extractValue('comments') || [];\n        reconstructedObject.header = extractValue('header');\n        reconstructedObject.entityId = extractValue('entityId');\n        reconstructedObject.shareUrn = extractValue('shareUrn');\n        reconstructedObject.shareLinkedinUrl = extractValue('shareLinkedinUrl');\n        reconstructedObject.engagement = extractValue('engagement');\n        reconstructedObject.reactions = extractValue('reactions') || [];\n        reconstructedObject.reactionIds = extractValue('reactionIds') || [];\n        reconstructedObject.commentIds = extractValue('commentIds') || [];\n        reconstructedObject.query = extractValue('query');\n\n        // Add to execution output schema\n        parsedItems.push({ json: reconstructedObject });\n    }\n\n    return parsedItems;\n\n} catch (error) {\n    return [{\n        json: { \n            error: \"Failed parsing plain-text block layout.\",\n            details: error.message\n        }\n    }];\n}"
