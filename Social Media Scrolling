        "jsCode": "// 1. Grab the 'text' string from the CURRENT item\nconst rawText = $json.content?.parts?.[0]?.text;\n\nif (!rawText) {\n  return { error: \"No text field found on this item.\" };\n}\n\ntry {\n  // Try parsing as normal JSON first\n  const parsedJson = JSON.parse(rawText);\n  return Array.isArray(parsedJson) ? (parsedJson[0] || {}) : parsedJson;\n\n} catch (error) {\n  // If JSON parsing fails, gracefully parse the markdown bullet-point layout\n  const result = {};\n  \n  // Regex to capture key-value structures like: - `key`: value or \"key\": value\n  const regex = /(?:-\\s*`?|[\"']?)([a-zA-Z0-9_\\s\\?]+)(?:`?|[\"']?)\\s*:\\s*(.*)/g;\n  let match;\n\n  while ((match = regex.exec(rawText)) !== null) {\n    let key = match[1].trim();\n    let value = match[2].trim();\n\n    // Clean up key variations (like matching JSON payload keys)\n    if (key === \"ID\") key = \"ID\";\n    if (key === \"competitor\") key = \"competitor\";\n\n    // Clean up stringified values, stripping extra quotes or trailing syntax\n    value = value.replace(/^[\"'`]|[\"'`]$/g, '').trim();\n\n    // Convert literal type representations cleanly\n    if (value === \"null\") {\n      result[key] = null;\n    } else if (value === \"false\") {\n      result[key] = false;\n    } else if (value === \"true\") {\n      result[key] = true;\n    } else {\n      result[key] = value;\n    }\n  }\n\n  // Ensure something was actually extracted, otherwise throw the original error\n  if (Object.keys(result).length > 0) {\n    return result;\n  }\n\n  return {\n    error: \"Failed to parse text via JSON or fallback Regex parser\",\n    details: error.message,\n    originalText: rawText\n  };\n}"
