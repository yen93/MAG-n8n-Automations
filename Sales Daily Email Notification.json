    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "Sales Automations Daily Updates",
        "message": "=<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Lead Outreach & Scraper Automation Summary</title>\n    <style>\n        /* Base Reset */\n        body, table, td, p, a {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n            margin: 0;\n            padding: 0;\n            -webkit-text-size-adjust: 100%;\n            -ms-text-size-adjust: 100%;\n        }\n        table, td {\n            mso-table-lspace: 0pt;\n            mso-table-rspace: 0pt;\n        }\n        body {\n            background-color: #000000;\n            color: #FFFFFF;\n            width: 100% !important;\n            height: 100% !important;\n        }\n    </style>\n</head>\n<body style=\"background-color: #000000; color: #FFFFFF; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; margin: 0; padding: 0;\">\n\n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color: #000000; table-layout: fixed;\">\n        <tr>\n            <td align=\"center\" valign=\"top\">\n                \n                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width: 600px; padding: 40px 20px;\">\n                    \n                    <tr>\n                        <td align=\"left\" valign=\"top\" style=\"padding-bottom: 40px; border-bottom: 1px solid #222222;\">\n                            <div style=\"height: 3px; width: 40px; background-color: #0088FF; margin-bottom: 20px;\"></div>\n                            \n                            <p style=\"font-size: 11px; font-weight: bold; letter-spacing: 3px; text-transform: uppercase; color: #FFFFFF; margin: 0;\">\n                                MY ADVENTURE GROUP\n                            </p>\n                        </td>\n                    </tr>\n\n                    <tr>\n                        <td align=\"left\" valign=\"top\" style=\"padding-top: 30px; font-size: 18px; color: #FFFFFF; letter-spacing: 0.5px;\">\n                            Hi <span style=\"font-size: 20px; font-weight: 800; color: #0088FF;\">{{ $json.first_name }}</span>,\n                        </td>\n                    </tr>\n\n                    <!-- SOCIAL MEDIA FOLLOW UP SEQUENCE -->\n                    <tr>\n                        <td align=\"left\" valign=\"top\" style=\"padding-top: 20px; padding-bottom: 24px;\">\n                            <h2 style=\"font-size: 24px; font-weight: 800; letter-spacing: 4px; text-transform: uppercase; color: #FFFFFF; margin: 0 0 16px 0; line-height: 1.2;\">\n                                SOCIAL MEDIA FOLLOW UP SEQUENCE\n                            </h2>\n                            <p style=\"font-size: 14px; line-height: 1.35; color: #A0A0A0; margin: 0;\">\n                                Your automated social media follow-up sequence metric log for the past 24 hours:\n                            </p>\n                        </td>\n                    </tr>\n                    \n                    <tr>\n                        <td align=\"left\" valign=\"top\" style=\"padding-bottom: 48px;\">\n                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse: collapse; background-color: #111111; border: 1px solid #222222;\">\n                                <thead>\n                                    <tr style=\"border-bottom: 2px solid #222222; background-color: #080808;\">\n                                        <th align=\"left\" style=\"padding: 16px; font-size: 11px; font-weight: bold; letter-spacing: 2px; text-transform: uppercase; color: #FFFFFF;\">\n                                            Sequence Step\n                                        </th>\n                                        <th align=\"right\" style=\"padding: 16px; font-size: 11px; font-weight: bold; letter-spacing: 2px; text-transform: uppercase; color: #FFFFFF;\">\n                                            Sent (Last 24h)\n                                        </th>\n                                    </tr>\n                                </thead>\n                                <tbody>\n                                    <tr style=\"border-bottom: 1px solid #222222;\">\n                                        <td align=\"left\" style=\"padding: 16px; font-size: 14px; color: #FFFFFF; line-height: 1.25;\">\n                                            First Follow-up <span style=\"color: #666666; font-size: 12px; font-weight: normal; margin-left: 4px;\">(Email 2)</span>\n                                        </td>\n                                        <td align=\"right\" style=\"padding: 16px; font-size: 15px; font-weight: bold; color: #FFFFFF;\">\n                                            {{ $('Limit1').item.json.soc_email_2nd_sent }}\n                                        </td>\n                                    </tr>\n                                    <tr style=\"border-bottom: 1px solid #222222;\">\n                                        <td align=\"left\" style=\"padding: 16px; font-size: 14px; color: #FFFFFF; line-height: 1.25;\">\n                                            Second Follow-up <span style=\"color: #666666; font-size: 12px; font-weight: normal; margin-left: 4px;\">(Email 3)</span>\n                                        </td>\n                                        <td align=\"right\" style=\"padding: 16px; font-size: 15px; font-weight: bold; color: #FFFFFF;\">\n                                            {{ $('Limit1').item.json.soc_email_3rd_sent }}\n                                        </td>\n                                    </tr>\n                                    <tr>\n                                        <td align=\"left\" style=\"padding: 16px; font-size: 14px; color: #FFFFFF; line-height: 1.25;\">\n                                            Final Follow-up <span style=\"color: #666666; font-size: 12px; font-weight: normal; margin-left: 4px;\">(Email 4)</span>\n                                        </td>\n                                        <td align=\"right\" style=\"padding: 16px; font-size: 15px; font-weight: bold; color: #FFFFFF;\">\n                                            {{ $('Limit1').item.json.soc_email_4th_sent }}\n                                        </td>\n                                    </tr>\n                                </tbody>\n                            </table>\n                        </td>\n                    </tr>\n\n                    <!-- COLD LEADS FOLLOW UP SEQUENCE -->\n                    <tr>\n                        <td align=\"left\" valign=\"top\" style=\"padding-bottom: 24px; border-top: 1px solid #222222; padding-top: 40px;\">\n                            <h2 style=\"font-size: 24px; font-weight: 800; letter-spacing: 4px; text-transform: uppercase; color: #FFFFFF; margin: 0 0 16px 0; line-height: 1.2;\">\n                                COLD LEADS FOLLOW UP SEQUENCE\n                            </h2>\n                            <p style=\"font-size: 14px; line-height: 1.35; color: #A0A0A0; margin: 0;\">\n                                Automation metrics capturing cold outreach sequence progression:\n                            </p>\n                        </td>\n                    </tr>\n\n                    <tr>\n                        <td align=\"left\" valign=\"top\" style=\"padding-bottom: 48px;\">\n                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse: collapse; background-color: #111111; border: 1px solid #222222;\">\n                                <thead>\n                                    <tr style=\"border-bottom: 2px solid #222222; background-color: #080808;\">\n                                        <th align=\"left\" style=\"padding: 16px; font-size: 11px; font-weight: bold; letter-spacing: 2px; text-transform: uppercase; color: #FFFFFF;\">\n                                            Sequence Step\n                                        </th>\n                                        <th align=\"right\" style=\"padding: 16px; font-size: 11px; font-weight: bold; letter-spacing: 2px; text-transform: uppercase; color: #FFFFFF;\">\n                                            Count Log\n                                        </th>\n                                    </tr>\n                                </thead>\n                                <tbody>\n                                    <tr style=\"border-bottom: 1px solid #222222;\">\n                                        <td align=\"left\" style=\"padding: 16px; font-size: 14px; color: #FFFFFF; line-height: 1.25;\">\n                                            Cold Follow-up 1 <span style=\"color: #666666; font-size: 12px; font-weight: normal; margin-left: 4px;\">(Email 2)</span>\n                                        </td>\n                                        <td align=\"right\" style=\"padding: 16px; font-size: 15px; font-weight: bold; color: #FFFFFF;\">\n                                            {{ $('Limit1').item.json.cold_email_2nd_sent }}\n                                        </td>\n                                    </tr>\n                                    <tr style=\"border-bottom: 1px solid #222222;\">\n                                        <td align=\"left\" style=\"padding: 16px; font-size: 14px; color: #FFFFFF; line-height: 1.25;\">\n                                            Cold Follow-up 2 <span style=\"color: #666666; font-size: 12px; font-weight: normal; margin-left: 4px;\">(Email 3)</span>\n                                        </td>\n                                        <td align=\"right\" style=\"padding: 16px; font-size: 15px; font-weight: bold; color: #FFFFFF;\">\n                                            {{ $('Limit1').item.json.cold_email_3rd_sent }}\n                                        </td>\n                                    </tr>\n                                    <tr style=\"border-bottom: 1px solid #222222;\">\n                                        <td align=\"left\" style=\"padding: 16px; font-size: 14px; color: #FFFFFF; line-height: 1.25;\">\n                                            Cold Follow-up 3 <span style=\"color: #666666; font-size: 12px; font-weight: normal; margin-left: 4px;\">(Email 4)</span>\n                                        </td>\n                                        <td align=\"right\" style=\"padding: 16px; font-size: 15px; font-weight: bold; color: #FFFFFF;\">\n                                            {{ $('Limit1').item.json.cold_email_4th_sent }}\n                                        </td>\n                                    </tr>\n                                    <tr>\n                                        <td align=\"left\" style=\"padding: 16px; font-size: 14px; color: #FFFFFF; line-height: 1.25;\">\n                                            Cold Final Follow-up <span style=\"color: #666666; font-size: 12px; font-weight: normal; margin-left: 4px;\">(Email 5)</span>\n                                        </td>\n                                        <td align=\"right\" style=\"padding: 16px; font-size: 15px; font-weight: bold; color: #FFFFFF;\">\n                                            {{ $('Limit1').item.json.cold_email_5th_sent }}\n                                        </td>\n                                    </tr>\n                                </tbody>\n                            </table>\n                        </td>\n                    </tr>\n\n                    <!-- LINKEDIN SCRAPER -->\n                    <tr>\n                        <td align=\"left\" valign=\"top\" style=\"padding-bottom: 24px; border-top: 1px solid #222222; padding-top: 40px;\">\n                            <h2 style=\"font-size: 24px; font-weight: 800; letter-spacing: 4px; text-transform: uppercase; color: #FFFFFF; margin: 0 0 16px 0; line-height: 1.2;\">\n                                LINKEDIN SCRAPER\n                            </h2>\n                            <p style=\"font-size: 14px; line-height: 1.35; color: #A0A0A0; margin: 0;\">\n                                Automation data overview capturing recent social platform ingestion pipelines:\n                            </p>\n                        </td>\n                    </tr>\n\n                    <tr>\n                        <td align=\"left\" valign=\"top\" style=\"padding-bottom: 40px;\">\n                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse: collapse; background-color: #111111; border: 1px solid #222222;\">\n                                <thead>\n                                    <tr style=\"border-bottom: 2px solid #222222; background-color: #080808;\">\n                                        <th align=\"left\" style=\"padding: 16px; font-size: 11px; font-weight: bold; letter-spacing: 2px; text-transform: uppercase; color: #FFFFFF;\">\n                                            Pipeline Metric\n                                        </th>\n                                        <th align=\"right\" style=\"padding: 16px; font-size: 11px; font-weight: bold; letter-spacing: 2px; text-transform: uppercase; color: #FFFFFF;\">\n                                            Count Log\n                                        </th>\n                                    </tr>\n                                </thead>\n                                <tbody>\n                                    <tr style=\"border-bottom: 1px solid #222222;\">\n                                        <td align=\"left\" style=\"padding: 16px; font-size: 14px; color: #FFFFFF; line-height: 1.25;\">\n                                            Competitor Speakers Evaluated\n                                        </td>\n                                        <td align=\"right\" style=\"padding: 16px; font-size: 15px; font-weight: bold; color: #FFFFFF;\">\n                                            {{ $('Limit1').item.json.profiles_scraped }}\n                                        </td>\n                                    </tr>\n                                    <tr style=\"border-bottom: 1px solid #222222;\">\n                                        <td align=\"left\" style=\"padding: 16px; font-size: 14px; color: #FFFFFF; line-height: 1.25;\">\n                                            Speaker Profiles with Active Posts\n                                        </td>\n                                        <td align=\"right\" style=\"padding: 16px; font-size: 15px; font-weight: bold; color: #FFFFFF;\">\n                                            {{ $('Limit1').item.json.profiles_with_posts }}\n                                        </td>\n                                    </tr>\n                                    <tr style=\"border-bottom: 1px solid #222222;\">\n                                        <td align=\"left\" style=\"padding: 16px; font-size: 14px; color: #FFFFFF; line-height: 1.25;\">\n                                            Total Target Posts Extracted\n                                        </td>\n                                        <td align=\"right\" style=\"padding: 16px; font-size: 15px; font-weight: bold; color: #FFFFFF;\">\n                                            {{ $('Limit1').item.json.scraped_posts }}\n                                        </td>\n                                    </tr>\n                                    <tr>\n                                        <td align=\"left\" style=\"padding: 16px; font-size: 14px; color: #FFFFFF; line-height: 1.25; font-weight: bold;\">\n                                            Verified Speaking Leads Identified\n                                        </td>\n                                        <td align=\"right\" style=\"padding: 16px; font-size: 15px; font-weight: bold; color: #0088FF;\">\n                                            {{ $('Limit1').item.json.is_verified_lead }}\n                                        </td>\n                                    </tr>\n                                </tbody>\n                            </table>\n                        </td>\n                    </tr>\n                    \n                    <tr>\n                        <td align=\"left\" valign=\"top\" style=\"padding-top: 20px; border-top: 1px solid #222222;\">\n                            <p style=\"font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #444444; margin: 0;\">\n                                // END SUMMARY RUN — AUTOMATION SECURE\n                            </p>\n                        </td>\n                    </tr>\n\n                </table>\n            </td>\n        </tr>\n    </table>\n</body>\n</html>",
