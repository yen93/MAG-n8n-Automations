    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    -- LinkedIn Scraper Metrics\n    linkedin.scraped_posts,\n    linkedin.is_verified_lead,\n    linkedin.profiles_scraped,\n    linkedin.profiles_with_posts,\n\n    -- Soc Med Outreach Follow-up Metrics \n    soc_email_2nd_sent,\n    soc_email_3rd_sent,\n    soc_email_4th_sent,\n    \n    -- Cold Leads Outreach Follow-up Metrics \n    cold_email_2nd_sent,\n    cold_email_3rd_sent,\n    cold_email_4th_sent,\n    cold_email_5th_sent\nFROM (\n    SELECT \n        COUNT(id) AS scraped_posts,\n        COUNT(id) FILTER (WHERE is_speaking_engagement = true) AS is_verified_lead,\n        (SELECT COUNT(DISTINCT proper_name) FROM speakers WHERE status IS NULL) AS profiles_scraped,\n        COUNT(DISTINCT proper_name) AS profiles_with_posts\n    FROM linkedin_posts\n    WHERE datetime_logged >= NOW() - INTERVAL '28 hours'\n) linkedin\nCROSS JOIN (\n    SELECT \n        COUNT(email_2nd_date_sent) FILTER (WHERE email_2nd_date_sent >= NOW() - INTERVAL '28 hours') AS soc_email_2nd_sent,\n        COUNT(email_3rd_date_sent) FILTER (WHERE email_3rd_date_sent >= NOW() - INTERVAL '28 hours') AS soc_email_3rd_sent,\n        COUNT(email_4th_date_sent) FILTER (WHERE email_4th_date_sent >= NOW() - INTERVAL '28 hours') AS soc_email_4th_sent\n    FROM follow_up_sequence_threads\n) soc\nCROSS JOIN (\n    SELECT \n        COUNT(email_2nd_date_sent) FILTER (WHERE email_2nd_date_sent >= NOW() - INTERVAL '28 hours') AS cold_email_2nd_sent,\n        COUNT(email_3rd_date_sent) FILTER (WHERE email_3rd_date_sent >= NOW() - INTERVAL '28 hours') AS cold_email_3rd_sent,\n        COUNT(email_4th_date_sent) FILTER (WHERE email_4th_date_sent >= NOW() - INTERVAL '28 hours') AS cold_email_4th_sent, \n        COUNT(email_5th_date_sent) FILTER (WHERE email_5th_date_sent >= NOW() - INTERVAL '28 hours') AS cold_email_5th_sent\n    FROM Cold_leads_follow_up_sequence_threads\n) cold;\n\n",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
