    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  daily_logs.daily_scraping_logs_count::int,\n  soc_med_sequence_logs.soc_med_follow_up_sequence_logs_count::int,\n  cold_leads_sequence_logs.cold_leads_follow_up_sequence_logs_count::int,\n  email_logs.sales_daily_email_count::int\nFROM (\n  SELECT count(*) as daily_scraping_logs_count \n  FROM daily_scraping_logs\n  WHERE created_at >= now() - interval '8 hours'\n) as daily_logs\nCROSS JOIN (\n  SELECT count(*) as soc_med_follow_up_sequence_logs_count \n  FROM follow_up_sequence_logs\n  WHERE created_at >= now() - interval '8 hours'\n  and lead_type = 'social media'\n) as soc_med_sequence_logs\nCROSS JOIN (\n  SELECT count(*) as cold_leads_follow_up_sequence_logs_count \n  FROM follow_up_sequence_logs\n  WHERE created_at >= now() - interval '8 hours'\n  and lead_type = 'cold leads'\n) as cold_leads_sequence_logs\nCROSS JOIN (\n  SELECT count(*) as sales_daily_email_count\n  FROM sales_daily_email_notification_logs\n  WHERE created_at >= now() - interval '8 hours'\n) as email_logs;",
        "options": {}
      },
