            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Apify Post Scraper": {
      "main": [
        [
          {
            "node": "AI Text Extractor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Text Extractor",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "AI Text Extractor": {
      "main": [
        [
          {
            "node": "Filter Valued Engagements",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Valued Engagements": {
      "main": [
        [
          {
            "node": "Write to Engagements Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
