{
  "name": "LinkedIn Speaker Competitor Intelligence Tracker",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyWeek"
            }
          ]
        }
      },
      "id": "e6f83cb4-541e-4cb6-ba50-019672728951",
      "name": "Schedule Trigger (Weekly)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Competitors",
          "mode": "name"
        },
        "options": {}
      },
      "id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
      "name": "Read Competitor Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [620, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_SHEETS_CRED_ID",
          "name": "Google Sheets Account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/harvestapi~linkedin-post-search/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "urls",
              "value": "={{ [ $json[\"LinkedIn Profile URL\"] ] }}"
            },
            {
              "name": "limit",
              "value": "10"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e",
      "name": "Apify Post Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "YOUR_APIFY_HEADER_CRED_ID",
          "name": "Apify API Token"
        }
      }
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "You are a corporate intelligence analyst tracking keynote speakers.\n\nAnalyze the text inside the provided LinkedIn post. Your objective is to discover if this post describes a real-world corporate presentation, workshop, or keynote speech given by the author to a client.\n\nExtract the following fields into a clean schema:\n1. Company: The brand, association, or enterprise they presented to.\n2. POC: The point of contact or host at that company who was tagged/thanked.\n3. Date of Engagement: The post creation date or time mentioned.\n4. Activity Date: The actual day they delivered the presentation, if distinct from the post date.\n\nCRITICAL: If the post is purely a personal reflection, blog post, or political/industry comment with no corporate speaking engagement client, return nothing for all fields. Do not guess."
        }
      },
      "id": "c3d4e5f6-a7b8-9c0d-1e2f-3a4b5c6d7e8f",
      "name": "AI Text Extractor",
      "type": "n8n-nodes-base.advancedAi",
      "typeVersion": 1.1,
      "position": [1060, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "responseFormat": "json_object"
        }
      },
      "id": "d4e5f6a7-b8c9-0d1e-2f3a-4b5c6d7e8f9a",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [1060, 520],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CRED_ID",
          "name": "OpenAI Account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "type": "string"
          },
          "conditions": [
            {
              "id": "check-company",
              "leftValue": "={{ $json.message.content.Company }}",
              "transitionProperty": "={{ $json.message.content.Company }}",
              "operator": "isNotEmpty"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e5f6a7b8-c9d0-1e2f-3a4b-5c6d7e8f9a0b",
      "name": "Filter Valued Engagements",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Engagements Tracker",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Competitor Name": "={{ $('Read Competitor Sheet').item.json[\"Speaker Name\"] }}",
            "Company Presented With": "={{ JSON.parse($json.message.content).Company }}",
            "POC from Company": "={{ JSON.parse($json.message.content).POC }}",
            "Date of Engagement": "={{ JSON.parse($json.message.content).Date of Engagement }}",
            "Activity Date": "={{ JSON.parse($json.message.content).Activity Date }}"
          },
          "matchingColumns": []
        },
        "options": {}
      },
      "id": "f6a7b8c9-d0e1-2f3a-4b5c-6d7e8f9a0b1c",
      "name": "Write to Engagements Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1540, 280],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_SHEETS_CRED_ID",
          "name": "Google Sheets Account"
        }
      }
    }
  ],
  "connections": {
